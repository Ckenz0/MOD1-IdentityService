# Demonstrativo: copie para .env e substitua CHANGE_ME.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://auth_service:CHANGE_ME@127.0.0.1:5432/auth
DATABASE_SCHEMA=mod1_identity
JWT_PRIVATE_KEY_PATH=./keys/auth-private.pem
JWT_ISSUER=mod1-auth-local
JWT_AUDIENCE=engenharia-software-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_MIN_LENGTH=12
CORS_ORIGINS=[]
# Session, login and trusted frontend defaults
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS=8
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
FRONTEND_ORIGIN=http://127.0.0.1:5173
LOCAL_MAILBOX_ENABLED=false
# Transactional mail provider: auto, resend, local, smtp or disabled.
# Explicit resend never falls back to local/SMTP when credentials are missing.
MAIL_PROVIDER=auto
# For Resend set MAIL_PROVIDER=resend and provide an environment-only sending key:
# RESEND_API_KEY=re_YOUR_SECRET_KEY
# RESEND_FROM=Modulo 1 <access@YOUR_VERIFIED_DOMAIN>
RESEND_TIMEOUT_SECONDS=5
# SMTP_HOST, SMTP_PORT (587), SMTP_USERNAME, SMTP_PASSWORD and SMTP_FROM are optional.
# MFA_ENCRYPTION_KEY is a separate Fernet key supplied only through a secret store.
