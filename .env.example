# Demonstrativo: copie para .env e substitua CHANGE_ME.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://auth_service:CHANGE_ME@127.0.0.1:5432/auth
DATABASE_SCHEMA=mod1_identity
JWT_PRIVATE_KEY_PATH=./keys/auth-private.pem
JWT_ISSUER=mod1-auth-local
JWT_AUDIENCE=engenharia-software-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_MIN_LENGTH=12
CORS_ORIGINS=[]
